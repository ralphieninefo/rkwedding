# DigitalOcean Serverless Inference (application runtime)
DIGITALOCEAN_MODEL_ACCESS_KEY=
DIGITALOCEAN_MODEL_ID=
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run
INFERENCE_TIMEOUT_SECONDS=45

# Gmail Pub/Sub webhook. Use a long random value locally and in App Platform.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Keep sending disabled until the complete flow is tested and approved.
AUTO_SEND=false
