# DigitalOcean Serverless Inference (application runtime)
DIGITALOCEAN_MODEL_ACCESS_KEY=
DIGITALOCEAN_MODEL_ID=
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run
INFERENCE_TIMEOUT_SECONDS=45

# Gmail Pub/Sub webhook. Use a long random value locally and in App Platform.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Temporary development credential. Production should refresh OAuth server-side.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional complete OAuth client JSON; preferred over data/google_client_secret.json.
GOOGLE_CLIENT_SECRET_JSON=
GOOGLE_REFRESH_TOKEN=
GOOGLE_GMAIL_USER_ID=me

# Keep sending disabled until the complete flow is tested and approved.
AUTO_SEND=false

# Local development only. Never set this to true on the hosted app.
ALLOW_UNAUTHENTICATED_LOCAL=true
# Set the hosted password in App Platform as an encrypted environment value.
CONTROL_CENTER_USERNAME=raph
CONTROL_CENTER_PASSWORD=
CONTROL_CENTER_SESSION_TTL_HOURS=168

# Comma-separated Gmail addresses allowed to connect to this private app.
GOOGLE_ALLOWED_EMAILS=raphaelsirvent1994@gmail.com
GOOGLE_PRIMARY_EMAIL=raphaelkassia2027@gmail.com

# Local mode permits SQLite. App Platform must use APP_ENV=production with PostgreSQL.
APP_ENV=local
DATABASE_URL=sqlite:///data/wedding.db
